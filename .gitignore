# ══════════════════════════════════════════════════════════════
# .gitignore — multi-refrigerant-operability
# ══════════════════════════════════════════════════════════════

# ─── IDEs and editors ───
.idea/
.vscode/
*.swp
*.swo
*~

# ─── Python ───
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
*.whl

# ─── Virtual environments ───
venv/
.venv/
env/
.env/

# ─── Operating system ───
.DS_Store
Thumbs.db
desktop.ini

# ─── Jupyter ───
.ipynb_checkpoints/

# ─── Logs and temporary files ───
*.log
*.tmp
*.bak

# ─── Local working directories (not part of the published record) ───
auxil/
out/
paper/
preprint/
